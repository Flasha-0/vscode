{
  "name": "flasha-code",
  "displayName": "فلاشة كود",
  "description": "بيئة تطوير ذكية: 15 وضع، شات، وكلاء خلفيون، خوادم MCP، نظام ذاكرة وقواعد، تكامل GitHub/Supabase/Vercel/Firebase، معاينة مباشرة، 7 لغات",
  "version": "1.0.0",
  "publisher": "فلاشة كود",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Chat",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "localizedLanguages": [
    "ar",
    "en",
    "es",
    "fr",
    "zh",
    "hi",
    "pt"
  ],
  "contributes": {
    "commands": [
      {
        "command": "flasha.chat",
        "title": "فتح شات فلاشة كود",
        "category": "فلاشة كود"
      },
      {
        "command": "flasha.setMode",
        "title": "تغيير الوضع",
        "category": "فلاشة كود"
      },
      {
        "command": "flasha.checkpoint.save",
        "title": "حفظ نقطة تفتيش",
        "category": "فلاشة كود"
      },
      {
        "command": "flasha.checkpoint.restore",
        "title": "استعادة نقطة تفتيش",
        "category": "فلاشة كود"
      },
      {
        "command": "flasha.rules.generate",
        "title": "توليد القواعد تلقائياً",
        "category": "فلاشة كود"
      },
      {
        "command": "flasha.git.clone",
        "title": "استنساخ مستودع",
        "category": "فلاشة كود"
      },
      {
        "command": "flasha.deploy",
        "title": "نشر على Vercel",
        "category": "فلاشة كود"
      },
      {
        "command": "flasha.deploy.preview",
        "title": "نشر نسخة تجريبية على Vercel",
        "category": "فلاشة كود"
      },
      {
        "command": "flasha.preview",
        "title": "معاينة مباشرة",
        "category": "فلاشة كود"
      },
      {
        "command": "flasha.supabase.connect",
        "title": "الاتصال بـ Supabase",
        "category": "فلاشة كود"
      },
      {
        "command": "flasha.terminal",
        "title": "فتح الطرفية الذكية",
        "category": "فلاشة كود"
      },
      {
        "command": "flasha.terminal.run",
        "title": "اقتراح أمر AI",
        "category": "فلاشة كود"
      },
      {
        "command": "flasha.init",
        "title": "تهيئة مجلد فلاشة كود",
        "category": "فلاشة كود"
      },
      {
        "command": "flasha.template",
        "title": "قالب من مشروع جاهز",
        "category": "فلاشة كود"
      },
      {
        "command": "flasha.api",
        "title": "اختبار API",
        "category": "فلاشة كود"
      },
      {
        "command": "flasha.firebase.connect",
        "title": "الاتصال بـ Firebase",
        "category": "فلاشة كود"
      },
      {
        "command": "flasha.analytics",
        "title": "عرض التحليلات",
        "category": "فلاشة كود"
      },
      {
        "command": "flasha.env.switch",
        "title": "تبديل البيئة",
        "category": "فلاشة كود"
      },
      {
        "command": "flasha.providers",
        "title": "عرض مزودي النماذج",
        "category": "فلاشة كود"
      },
      {
        "command": "flasha.agents.list",
        "title": "تشغيل وكيل خلفي",
        "category": "فلاشة كود"
      },
      {
        "command": "flasha.agents.run",
        "title": "تشغيل وكيل...",
        "category": "فلاشة كود"
      },
      {
        "command": "flasha.agents.review",
        "title": "مراجعة سريعة للكود",
        "category": "فلاشة كود"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "flasha",
          "title": "فلاشة كود",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "flasha": [
        {
          "type": "webview",
          "id": "flasha.chat",
          "name": "شات"
        }
      ]
    },
    "configuration": {
      "title": "فلاشة كود",
      "properties": {
        "flasha.defaultModel": {
          "type": "string",
          "default": "opencode/big-pickle",
          "description": "Default AI model"
        },
        "flasha.defaultMode": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "plan",
            "build",
            "chat",
            "review",
            "debug",
            "test",
            "document",
            "refactor",
            "security",
            "deploy",
            "analyze",
            "design",
            "migrate",
            "git"
          ]
        },
        "flasha.language": {
          "type": "string",
          "default": "ar",
          "enum": [
            "ar",
            "en"
          ],
          "description": "UI language"
        },
        "flasha.opencodePort": {
          "type": "number",
          "default": 4096,
          "description": "OpenCode server port"
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.mts",
    "watch": "npx tsc -b tsconfig.json -w",
    "package": "npx vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.98.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.0"
  },
  "__metadata": {
    "id": "flasha-code",
    "publisherDisplayName": "فلاشة كود",
    "publisherId": "flasha-code"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
